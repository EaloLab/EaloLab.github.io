/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fontawesome/webfonts/*
  Cache-Control: public, max-age=31536000, immutable

# El CSS y JS pueden cambiar entre despliegues: se revalidan siempre (ETag, barato)
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
